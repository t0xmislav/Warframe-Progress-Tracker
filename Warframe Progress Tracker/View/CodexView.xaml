<UserControl x:Class="Warframe_Progress_Tracker.View.CodexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Warframe_Progress_Tracker.View"
             xmlns:model="clr-namespace:Warframe_Progress_Tracker.Model"
             xmlns:selectors="clr-namespace:Warframe_Progress_Tracker.View.TemplateSelectors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemCardTemplate">
            <local:ItemCard/>
        </DataTemplate>
        <DataTemplate x:Key="NodeCardTemplate">
            <local:NodeCard/>
        </DataTemplate>
        <selectors:CodexTemplateSelector x:Key="CodexTemplateSelector"
                                         ItemTemplate="{StaticResource ItemCardTemplate}"
                                         NodeTemplate="{StaticResource NodeCardTemplate}"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
            
            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" MinWidth="100"/>
        </StackPanel>

        <ListBox x:Name="ItemsList"
                 ItemsSource="{Binding FilteredEntries}" 
                 Tag="{Binding CurrentUser}"
                 ItemTemplateSelector="{StaticResource CodexTemplateSelector}"
                 ScrollViewer.ScrollChanged="ItemsList_ScrollChanged"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemWidth="160" ItemHeight="220"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DockPanel>
</UserControl>