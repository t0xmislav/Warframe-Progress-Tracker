<Window x:Class="Warframe_Progress_Tracker.View.CodexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Warframe_Progress_Tracker.View"
        xmlns:model="clr-namespace:Warframe_Progress_Tracker.Model"
        xmlns:selectors="clr-namespace:Warframe_Progress_Tracker.View.TemplateSelectors"
        mc:Ignorable="d"
        Title="Codex" Height="600" Width="900"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        d:DesignHeight="450" d:DesignWidth="800">
    <Window.Resources>
        <DataTemplate x:Key="ItemCardTemplate">
            <local:ItemCard/>
        </DataTemplate>
        <DataTemplate x:Key="NodeCardTemplate">
            <local:NodeCard/>
        </DataTemplate>
        <selectors:CodexTemplateSelector x:Key="CodexTemplateSelector"
                                         ItemTemplate="{StaticResource ItemCardTemplate}"
                                         NodeTemplate="{StaticResource NodeCardTemplate}"/>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <TextBlock Text="{DynamicResource CodexCategoryStr}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MaxHeight="25"/>

            <TextBlock Text="{DynamicResource CodexNameStr}" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" MinWidth="100" MaxHeight="25"/>
            <GroupBox Header="{DynamicResource CodexSortOptionsStr}" BorderBrush="Black" Margin="20,0,5,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Tag="Name" IsChecked="True" Checked="SortEntries_Checked"
                                 Content="{DynamicResource CodexSortNameStr}"/>
                    <RadioButton Tag="DateMastered" IsChecked="False" Checked="SortEntries_Checked"
                                 Content="{DynamicResource CodexSortDateStr}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource CodexClearFilterStr}" BorderBrush="Black" Margin="20,0,5,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Tag="All" IsChecked="True" Checked="ClearFilter_Checked" Content="{DynamicResource AllStr}" Margin="0,0,6,0"/>
                    <RadioButton Tag="Cleared" IsChecked="False" Checked="ClearFilter_Checked" Content="{DynamicResource ClearedStr}" Margin="0,0,6,0"/>
                    <RadioButton Tag="Uncleared" IsChecked="False" Checked="ClearFilter_Checked" Content="{DynamicResource UnclearedStr}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <ListBox x:Name="ItemsList"
                 ItemsSource="{Binding FilteredEntries}"
                 Tag="{Binding CurrentUser}"
                 ItemTemplateSelector="{StaticResource CodexTemplateSelector}"
                 ScrollViewer.ScrollChanged="ItemsList_ScrollChanged"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemWidth="160" ItemHeight="220"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DockPanel>
</Window>

