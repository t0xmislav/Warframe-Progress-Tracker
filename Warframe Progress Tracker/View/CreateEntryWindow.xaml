<Window x:Class="Warframe_Progress_Tracker.View.CreateEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Warframe_Progress_Tracker.View"
        mc:Ignorable="d"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        Title="Create Codex Entry" Height="450" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource EntryNameStr}"/>
            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

            <TextBlock Text="{DynamicResource EntryCategoryStr}"/>
            <ComboBox ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  Margin="0,5,0,10"/>

            <TextBlock Text="{DynamicResource EntryMasteryPointsStr}"/>
            <TextBox Text="{Binding MasteryPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{DynamicResource EntryPlanetStr}"/>
                <TextBox Text="{Binding Planet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
             Margin="0,5,0,10"/>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNode}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{DynamicResource EntryUniqueNameStr}"/>
                <TextBox Text="{Binding UniqueName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
            </StackPanel>

            <Button Content="{DynamicResource EntryChangeImageStr}" Margin="0,10,0,0" Command="{Binding ChangeImageCommand}"/>
            <Image Source="{Binding ImagePreview}" Height="100" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="{DynamicResource SaveStr}" Width="80" Margin="5" Command="{Binding SaveCommand}"/>
            <Button Content="{DynamicResource ExitStr}" Width="80" Margin="5" Command="{Binding ExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
