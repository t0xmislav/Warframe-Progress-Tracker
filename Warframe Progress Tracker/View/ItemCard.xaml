<UserControl x:Class="Warframe_Progress_Tracker.View.ItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Warframe_Progress_Tracker"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="150" Margin="5">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="Black">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Source="{Binding Item.ImageBitmap}" Stretch="UniformToFill"/>
            <StackPanel Grid.Row="1" Background="#AA000000" Margin="5">
                <TextBlock Text="{Binding Item.Name}" Foreground="White" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                <CheckBox IsChecked="{Binding Owned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Owned" Foreground="White" Margin="0,5,0,0">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Item.Category.DisplayName}" Value="Node">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <CheckBox IsChecked="{Binding Mastered, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Mastered" Foreground="White">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Content" Value="Matered"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Item.Category.DisplayName}" Value="Node">
                                    <Setter Property="Content" Value="Cleared"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="{Binding DateMastered, StringFormat='Mastered on {0:dd-MM-yyyy}'}" Foreground="LightGray" FontSize="10" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mastered}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
