<UserControl x:Class="Warframe_Progress_Tracker.View.ItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Warframe_Progress_Tracker"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="150" Margin="5">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="Black">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image x:Name="ItemImage" Stretch="UniformToFill"/>
            <StackPanel Grid.Row="1" Background="#AA000000" Margin="5">
                <TextBlock x:Name="ItemName" Foreground="White" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                <CheckBox x:Name="OwnedCheck" Content="Owned" Foreground="White" Margin="0,5,0,0"/>
                <CheckBox x:Name="MasteredCheck" Content="Mastered" Foreground="White"/>
                <TextBlock x:Name="DatesBlock" Foreground="LightGray" FontSize="10" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
