<Window x:Class="Warframe_Progress_Tracker.View.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Warframe_Progress_Tracker.View"
        mc:Ignorable="d"
        Title="Edit Item" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Name:"/>
            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
            
            <TextBlock Text="Category:"/>
            <ComboBox ItemsSource="{Binding Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding SelectedCategory, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      Margin="0,5,0,10"/>

            <TextBlock Text="Mastery Points:"/>
            <TextBox Text="{Binding MasteryPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

            
            <Button Content="Change Image..." Click="ChangeImage_Click" Margin="0,10,0,0"/>
            <Image x:Name="PreviewImage" Height="100" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Margin="5" Click="SaveItem_Click"/>
            <Button Content="Exit" Width="80" Margin="5" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
