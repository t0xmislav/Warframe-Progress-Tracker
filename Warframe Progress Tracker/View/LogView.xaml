<UserControl x:Class="Warframe_Progress_Tracker.View.LogView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Warframe_Progress_Tracker.View"
      xmlns:utils="clr-namespace:Warframe_Progress_Tracker.Utils"
      mc:Ignorable="d" 
      Background="{DynamicResource PrimaryBackgroundBrush}"
      Foreground="{DynamicResource PrimaryForegroundBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
      >
        <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </UserControl.Resources>
        <Grid>
        <DataGrid x:Name="LogDataGrid" AutoGenerateColumns="False" ItemsSource="{Binding Logs}" IsReadOnly="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource LogDateStr}" Binding="{Binding Path=Timestamp, StringFormat='{}{0:G}'}" IsReadOnly="True" Width="125"/>
                <DataGridTextColumn Header="{DynamicResource LogActionStr}" Binding="{Binding Path=Action}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource LogDetailsStr}" Binding="{Binding Path=Details}" IsReadOnly="True" Width="2*"/>
                <DataGridTemplateColumn Header="{DynamicResource LogNoteStr}" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AdminNote}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding AdminNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                     KeyDown="AdminNoteTextBox_KeyDown"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource SaveStr}" Command="{Binding SaveCommand}" 
                                    IsEnabled="{Binding IsDirty}"
                                    Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"
                                    Width="50"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="{DynamicResource LogModifiedDateStr}" Binding="{Binding Path=LastModified, StringFormat='{}{0:G}'}" IsReadOnly="True" Width="200"/>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource DeleteStr}" Command="{Binding DeleteCommand}" 
                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"
                            Width="70"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>


</UserControl>
