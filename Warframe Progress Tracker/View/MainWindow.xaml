<Window x:Class="Warframe_Progress_Tracker.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Warframe_Progress_Tracker"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="3">
            <MenuItem Header="_File">
                <MenuItem Header="Logout" Click="Logout_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Codex">
                <MenuItem Header="Open Codex" Click="OpenCodex_Click"/>
            </MenuItem>
            <MenuItem Header="_Account">
                <MenuItem Header="Account Settings" Click="OpenAccountSettings_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Populate Items Database" Click="PopulateDb_Click"/>
            </MenuItem>
            
        </Menu>
        <ContentControl x:Name="MainContent"/>
    </DockPanel>

</Window>
