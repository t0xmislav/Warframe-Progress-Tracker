<UserControl x:Class="Warframe_Progress_Tracker.View.NodeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Warframe_Progress_Tracker.View"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="200" d:DesignWidth="150">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
        <Grid>
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit" Click="EditNode_Click"/>
                    <MenuItem Header="Delete" Click="DeleteNode_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Source="{Binding ImageBitmap}" Stretch="UniformToFill"/>
            <StackPanel Grid.Row="1" Margin="5">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                <CheckBox x:Name="ClearedNormalCheck" Content="{DynamicResource NormalClearStr}" Margin="0,5,0,0">
                </CheckBox>
                <TextBlock x:Name="NormalDateBlock" FontSize="10" TextAlignment="Center">
                </TextBlock>
                <CheckBox x:Name="ClearedSteelCheck" Content="{DynamicResource SteelPathClearStr}">
                </CheckBox>
                <TextBlock x:Name="SteelDateBlock" FontSize="10" TextAlignment="Center">
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
